{
  "manifest_version": 3,
  "name": "X (Twitter) Mass Unfollow Tool - Bulk Following Cleaner",
  "version": "6.28.0",
  "description": "X/Twitter unfollow manager with bulk unfollow, non-followers cleaner, smart filters, safety limits, analytics & CSV export",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://abs.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "X Unfollow Manager Pro",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "graphql.js",
        "listrun.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "emergency-stop": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Emergency stop the running unfollow session"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "worker.js"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ]
    }
  ],
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
